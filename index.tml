<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>ClipAI – YouTube to Shorts</title>
<style>
:root{--bg:#0b0b10;--card:#15151d;--line:#262633;--text:#f2f2f7;--mute:#9a9ab0;--accent:#7c5cff;--accent2:#ff4d8d;color-scheme:dark;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,sans-serif;line-height:1.5}
.wrap{max-width:1000px;margin:0 auto;padding:32px 18px 60px}
.logo{font-weight:800;font-size:20px;letter-spacing:-.3px}.logo span{background:linear-gradient(90deg,var(--accent),var(--accent2));-webkit-background-clip:text;background-clip:text;color:transparent}
h1{font-size:clamp(28px,6vw,46px);line-height:1.1;margin:40px 0 12px;letter-spacing:-1px;text-align:center}
.sub{color:var(--mute);text-align:center;max-width:560px;margin:0 auto 28px}
.box{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:14px;display:flex;flex-direction:column;gap:12px}
input{width:100%;background:#0e0e14;border:1px solid var(--line);color:var(--text);border-radius:12px;padding:18px 16px;font-size:17px;outline:none}
input:focus{border-color:var(--accent)}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.row label{color:var(--mute);font-size:14px}
.row input{width:90px;padding:10px 12px;font-size:15px}
button{font:inherit;cursor:pointer;border:0;border-radius:12px;color:#fff;font-weight:700}
.go{background:linear-gradient(90deg,var(--accent),var(--accent2));padding:16px;font-size:18px;width:100%}
.go:hover{filter:brightness(1.1)}
.err{color:#ff7b8f;font-size:14px;min-height:20px;text-align:center;margin-top:10px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:18px;margin-top:30px}
.clip{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:12px}
.frame{position:relative;aspect-ratio:9/16;border-radius:12px;overflow:hidden;background:#000;display:flex;align-items:center;justify-content:center}
.frame iframe{position:absolute;top:0;left:50%;height:100%;width:177.78%;transform:translateX(-50%);border:0}
.play{background:rgba(255,255,255,.14);width:64px;height:64px;border-radius:50%;font-size:24px}
.badge{position:absolute;top:8px;left:8px;background:rgba(0,0,0,.65);border-radius:8px;padding:2px 8px;font-size:12px;z-index:2}
.meta{display:flex;justify-content:space-between;margin:10px 2px 8px;font-size:14px}.meta span{color:var(--mute)}
.acts{display:flex;gap:8px}.acts button{flex:1;padding:10px;font-size:14px;background:#23233a}
.acts .dl{background:var(--accent)}
.note{color:var(--mute);font-size:13px;text-align:center;margin-top:36px}
.spin{text-align:center;color:var(--mute);margin-top:30px}
.toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:#222236;border:1px solid var(--line);padding:12px 16px;border-radius:12px;max-width:90vw;font-size:14px;display:none;z-index:9}
</style>
</head>
<body>
<div class="wrap">
  <div class="logo">Clip<span>AI</span></div>
  <h1>Turn long videos into<br>viral Shorts in one click</h1>
  <p class="sub">Paste a YouTube link. Get vertical 9:16 clips ready for Shorts, Reels and TikTok.</p>

  <div class="box">
    <input id="url" type="url" placeholder="Paste YouTube link here…" autocomplete="off">
    <div class="row"><label for="len">Video length (minutes)</label><input id="len" type="number" min="1" max="600" value="20"></div>
    <button class="go" id="go">Generate Clips</button>
  </div>
  <div class="err" id="err"></div>
  <div id="out"></div>
  <p class="note">Previews play the original video cropped to 9:16 with YouTube captions on. Downloads and AI moment detection need the backend connected (see API_URL in the page source).</p>
</div>
<div class="toast" id="toast"></div>
<script>
var API_URL = "";

var $ = function(id){return document.getElementById(id)};
function toast(m){var t=$("toast");t.textContent=m;t.style.display="block";clearTimeout(toast.t);toast.t=setTimeout(function(){t.style.display="none"},3500)}
function getId(u){
  var m=u.match(/(?:youtu\.be\/|v=|shorts\/|embed\/)([A-Za-z0-9_-]{11})/);
  return m?m[1]:null;
}
function fmt(s){var m=Math.floor(s/60),x=s%60;return m+":"+(x<10?"0":"")+x}

function localClips(minutes){
  var total=Math.max(60,Math.round(minutes*60)),n=Math.min(6,Math.max(3,Math.floor(total/120))),out=[];
  var step=total/(n+1);
  for(var i=1;i<=n;i++){
    var dur=[30,45,25,40,35,50][i%6],start=Math.max(0,Math.round(step*i-dur/2));
    out.push({start:start,end:start+dur,score:null});
  }
  return out;
}

function render(id,clips){
  var h='<div class="grid">';
  clips.forEach(function(c,i){
    h+='<div class="clip"><div class="frame" id="f'+i+'"><span class="badge">Clip '+(i+1)+'</span><button class="play" data-i="'+i+'" aria-label="Play clip">▶</button></div>'+
    '<div class="meta"><b>'+(c.end-c.start)+' sec</b><span>'+fmt(c.start)+' – '+fmt(c.end)+'</span></div>'+
    '<div class="acts"><button data-share="'+i+'">Copy link</button><button class="dl" data-dl="'+i+'">Download</button></div></div>';
  });
  $("out").innerHTML=h+'</div>';
  $("out").onclick=function(e){
    var t=e.target;
    if(t.dataset.i!==undefined){
      var c=clips[t.dataset.i],f=$("f"+t.dataset.i);
      var s='https://www.youtube-nocookie.com/embed/'+id+'?start='+c.start+'&end='+c.end+'&autoplay=1&cc_load_policy=1&playsinline=1&rel=0&modestbranding=1';
      f.innerHTML='<span class="badge">Clip '+(Number(t.dataset.i)+1)+'</span><iframe src="'+s+'" allow="autoplay; encrypted-media" allowfullscreen></iframe>';
    }
    if(t.dataset.share!==undefined){
      var d=clips[t.dataset.share],link='https://youtu.be/'+id+'?t='+d.start;
      if(navigator.clipboard){navigator.clipboard.writeText(link).then(function(){toast("Link copied")},function(){toast(link)})}else{toast(link)}
    }
    if(t.dataset.dl!==undefined){
      var k=clips[t.dataset.dl];
      if(k.downloadUrl){window.open(k.downloadUrl,"_blank")}
      else toast("Downloads need the clipping backend. Connect API_URL to enable them.");
    }
  };
}

$("go").onclick=function(){
  var u=$("url").value.trim(),id=getId(u);
  $("err").textContent="";
  if(!id){$("err").textContent="Please paste a valid YouTube link.";return}
  $("out").innerHTML='<div class="spin">Analyzing video…</div>';
  var done=function(clips){render(id,clips);$("out").scrollIntoView({behavior:"smooth"})};
  if(API_URL){
    fetch(API_URL,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({url:u})})
      .then(function(r){return r.json()}).then(function(d){done(d.clips)})
      .catch(function(){$("out").innerHTML="";$("err").textContent="Backend unavailable. Try again later."});
  } else {
    setTimeout(function(){done(localClips(parseFloat($("len").value)||20))},700);
  }
};
$("url").addEventListener("keydown",function(e){if(e.key==="Enter")$("go").click()});
</script>
</body>
</html>
